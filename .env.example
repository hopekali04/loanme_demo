# Environment Variables Template
# Copy this file and fill in your values

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Example for Supabase:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:5432/postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-supabase-password

# Example for AWS RDS:
# DATABASE_URL=jdbc:postgresql://your-instance.xxxxx.us-east-1.rds.amazonaws.com:5432/loanportal
# DATABASE_USERNAME=admin
# DATABASE_PASSWORD=your-rds-password

# Generic format:
DATABASE_URL=jdbc:postgresql://host:5432/database
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# ========================================
# SECURITY
# ========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-strong-secret-minimum-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# REDIS CACHE (Optional)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ========================================
# APPLICATION
# ========================================
PORT=8080
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ========================================
# DATABASE CONNECTION POOL
# ========================================
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
